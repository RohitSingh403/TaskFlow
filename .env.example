NODE_ENV=development
PORT=4000
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow
REDIS_URL=redis://127.0.0.1:6379
BULL_PREFIX=taskflow
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
CORS_ORIGIN=http://localhost:5173
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
LOG_LEVEL=info

# Optional stable id for a worker process. Leave unset to generate one per process.
# WORKER_ID=
WORKER_POLL_MS=5000
WORKER_LOCK_DURATION_MS=30000
WORKER_STALLED_INTERVAL_MS=30000

# Used only by `npm run seed`.
SEED_EMAIL=ada@example.com
SEED_PASSWORD=replace-with-a-password-you-choose
SEED_NAME=Ada Lovelace
